# Copie para config/device.env (fica fora do git) e ajuste.

# Serial do device (veja `adb devices`). Obrigatório se houver mais de um conectado.
# Wi-Fi: algo como 192.168.0.10:5555 ou adb-XXXX._adb-tls-connect._tcp
ANDROID_SERIAL=

# Pacote(s) do app em teste, separados por vírgula. O guard só permite clear/uninstall/permissões nesses.
# Descubra com: adb shell pm list packages | grep -i <nome>
TARGET_PACKAGES=com.exemplo.app

# droid prep: 1 = ativa, 0 = não mexe
USE_DND=1          # Não perturbe durante a sessão (evita notificações pessoais nas evidências)
MUTE_MEDIA=1       # volume de mídia em 0 (restaurado no `droid restore`)
SHOW_TOUCHES=1     # mostra os toques na tela (ótimo para vídeos de bug)
